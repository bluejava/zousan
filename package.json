{
	"name": "zousan",
	"version": "4.3.0",
	"description": "A fast, small Promise/A+ implementation with optional async workflow utilities",
	"keywords": [
		"async",
		"evaluate",
		"promises-aplus",
		"promise",
		"series",
		"workflow"
	],
	"homepage": "https://github.com/bluejava/zousan#readme",
	"bugs": {
		"url": "https://github.com/bluejava/zousan/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bluejava/zousan.git"
	},
	"license": "MIT",
	"author": "Glenn Crownover <glenn@bluejava.com> (http://www.bluejava.com)",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./src/zousan.d.ts",
				"default": "./src/zousan.js"
			},
			"require": {
				"types": "./zousan-min.d.cts",
				"default": "./zousan-min.cjs"
			}
		},
		"./series": {
			"import": {
				"types": "./src/series.d.ts",
				"default": "./src/series.js"
			},
			"require": {
				"types": "./dist/series.d.cts",
				"default": "./dist/series.cjs"
			}
		},
		"./evaluate": {
			"import": {
				"types": "./src/evaluate.d.ts",
				"default": "./src/evaluate.js"
			},
			"require": {
				"types": "./dist/evaluate.d.cts",
				"default": "./dist/evaluate.cjs"
			}
		}
	},
	"types": "./src/zousan.d.ts",
	"main": "./zousan-min.cjs",
	"module": "./src/zousan.js",
	"directories": {
		"test": "test"
	},
	"files": [
		"CHANGELOG.md",
		"dist/evaluate.cjs",
		"dist/evaluate.d.cts",
		"dist/series.cjs",
		"dist/series.d.cts",
		"src/evaluate.d.ts",
		"src/evaluate.js",
		"src/series.d.ts",
		"src/series.js",
		"src/zousan.d.ts",
		"src/zousan.js",
		"zousan-min.d.cts",
		"zousan-min.cjs"
	],
	"scripts": {
		"build": "node scripts/build.cjs",
		"prepack": "npm run build",
		"test": "npm run build && npm ci --prefix test && npm test --prefix test && node scripts/test-package-exports.cjs"
	},
	"devDependencies": {
		"rollup": "^4.62.2",
		"terser": "^5.48.0"
	},
	"packageManager": "npm@10.8.1"
}
